---
import { Arrow } from "@components/ui/icons";
import Layout from "@layouts/Layout.astro";
import Button from "@components/ui/button.astro";
import Container from "@components/container.astro";
import type { Experience } from "@experience/experienceSchema";
import { experienceCollection } from "@experience/experienceCollection";
import { formatExperienceDate } from "@experience/experienceUtils";
import { routes } from "@utils/routes";

// Generate a new path for every experience
export async function getStaticPaths() {
  return experienceCollection.map((experience) => ({
    props: experience,
    params: { slug: experience.slug },
  }));
}

type Props = Experience;

// Get the blog directly from the prop on render
const {
  tags,
  render,
  from,
  image,
  job,
  organization,
  slug,
  url,
  location,
  snippets,
  to,
} = Astro.props;

const title = `${job}, ${organization}${location ? ` — ${location}` : ""}`;
const description = snippets[0];

const { Content, headings } = await render();
---

<!-- image={image.src.src} -->
<Layout {title} {description}>
  <Container>
    <div class="mx-auto mt-14">
      <div class="w-full md:w-auto flex flex-wrap gap-3">
        {
          tags.map((tag) => (
            <span class="badge badge-sm bg-pink-200 text-pink-800">#{tag}</span>
          ))
        }
      </div>
      <h1
        class="text-4xl lg:text-5xl lg:tracking-tight mt-8 lg:leading-tight font-normal">
        {job}, <strong class="text-pink-500">{organization}</strong>
      </h1>
      <p class="text-gray-500 mt-4 sm:mt-0">{description}</p>
    </div>

    <div class="flex gap-8 mt-10 lg:mt-20">
      <div class="flex-1 prose prose-lg max-w-full scroll-pt-56">
        <Content />
      </div>
      <div class="hidden lg:block flex-shrink-0 flex-1 max-w-96">
        <div
          class="sticky top-28 bg-white border border-gray-200 rounded-lg p-4 shadow-sm h-fit max-h-[calc(100vh-6rem)] w-full">
          <div class="mb-4 pb-4 border-b border-gray-200">
            <h3 class="font-semibold text-sm text-gray-900 mb-2">Tenure</h3>
            <p class="text-sm text-gray-600">
              <time datetime={from.toISOString()}>
                {formatExperienceDate(from)}
              </time> — {
                to ? (
                  <time datetime={to.toISOString()}>
                    {formatExperienceDate(to)}
                  </time>
                ) : (
                  "Present"
                )
              }
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-sm text-gray-900 mb-3">Contents</h3>
            <nav class="space-y-1">
              {
                headings
                  .filter((heading) => heading.depth === 2)
                  .map((heading) => (
                    <a
                      href={`#${heading.slug}`}
                      class="block text-sm text-gray-600 hover:text-pink-600 transition-colors duration-200 py-1">
                      {heading.text}
                    </a>
                  ))
              }
            </nav>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-20 flex flex-col gap-4 sm:flex-row justify-between">
      <p>
        Got something fun for me? <a
          href={routes.contact}
          class="underline text-pink-500">Hit me up</a
        >
      </p>
      <Button
        as="a"
        href={routes.experiences}
        style="inverted"
        class="self-start sm:self-end">
        <Arrow class="rotate-180" /> Back to resume
      </Button>
    </div>
  </Container>
</Layout>
