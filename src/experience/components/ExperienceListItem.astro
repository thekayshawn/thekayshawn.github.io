---
import { routes } from "@utils/routes";
import type { Experience } from "..";

type Props = Experience;

const { slug } = Astro.props;
---

<li
  class="group relative py-8 md:p-8 hover:bg-slate-100 focus-within:bg-slate-100 rounded-content transition-all min-w-[600px] w-full">
  <slot />
  <a
    href={routes.getExperience(slug)}
    class="opacity-0 absolute top-0 left-0 w-full h-full">
    Learn More</a
  >
</li>
