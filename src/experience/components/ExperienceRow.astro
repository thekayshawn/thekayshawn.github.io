---
import { formatExperienceDate } from "@experience/experienceUtils";
import type { Experience } from "../experienceSchema";

type Props = Experience;

const { job, organization, from, to, snippets, location } = Astro.props;
---

<article class="prose prose-li:marker:text-pink-500 max-w-full">
  <!-- Body -->
  <div class="flex flex-col gap-element md:flex-grow">
    <!-- Title -->
    <div class="flex items-center justify-between gap-4">
      <div>
        <h4 class="inline">{job},</h4><p class="inline">
          {organization}{location && ` — ${location}`}
        </p>
      </div>
      <div>
        <time datetime={from.toISOString()}>
          {formatExperienceDate(from)}
        </time> - {
          to ? (
            <time datetime={to.toISOString()}>{formatExperienceDate(to)}</time>
          ) : (
            "Present"
          )
        }
      </div>
    </div>
    <!-- End Title -->
    <!-- Snippet -->
    <ul class="leading-relaxed text-secondary">
      {snippets.map((snippet) => <li>{snippet}</li>)}
    </ul>
    <!-- End Snippet -->
    <!-- Tags -->
    <!-- {
      tags.length > 0 && (
        <ul class="flex gap-element">
          {tags.map((tag) => (
            <li class="badge badge-sm bg-amber-200 text-amber-800 opacity-60">
              #{tag}
            </li>
          ))}
        </ul>
      )
    } -->
    <!-- End Tags -->
  </div>
  <!-- End Body -->
</article>
