---
import { Picture } from "astro:assets";
import { projectsPage } from "@utils/pages";
import type { Project } from "../projectSchema";
import { Arrow } from "@components/ui/icons";

interface Props extends Omit<Project, "slug"> {
  index: number;
}

const { tags, image, title, snippet, color, category, releaseDate } =
  Astro.props;

const hasTags = tags.length > 0;
---

<article class="flex flex-col h-full">
  <!-- Cover -->
  <Picture
    width={800}
    height={400}
    format="webp"
    loading="lazy"
    decoding="async"
    src={image.src}
    alt={image.alt}
    sizes="(max-width: 800px) 100vw, 800px"
    class="w-full object-cover object-center aspect-video border-b-2 bg-white rounded-t-lg"
  />
  <!-- Body -->
  <div class="h-full flex flex-col gap-4 p-4 justify-between">
    <!-- Body Content -->
    <div class="flex flex-col gap-4">
      <!-- Meta -->
      <div class="flex gap-4 items-center justify-between">
        <!-- Title -->
        <h3>{title}</h3>
        <!-- End Title -->
        <!-- Header -->
        <div class="flex items-center gap-2">
          <time class="text-secondary" datetime={releaseDate.toISOString()}>
            {releaseDate.getFullYear()}
          </time>
          <span class={`badge badge-sm text-white bg-${color}-500`}>
            {category}
          </span>
        </div>
        <!-- End Header -->
      </div>
      <p class="leading-relaxed text-secondary">
        {snippet}
      </p>
      <!-- End Meta -->
    </div>
    <!-- End Body Content -->
    <!-- Footer -->
    <div
      class={`flex justify-between gap-element ${!hasTags ? "self-end" : ""}`}>
      <!-- Tags -->
      {
        hasTags && (
          <ul class="flex gap-element flex-grow flex-wrap">
            {tags.map((tag) => (
              <li class="badge badge-sm bg-pink-200 text-pink-800 opacity-80">
                #{tag}
              </li>
            ))}
          </ul>
        )
      }
      <!-- End Tags -->
      <!-- CTA -->
      <span class="inline-flex items-center flex-shrink-0 text-pink-500">
        <Arrow class="ml-2" />
      </span>
      <!-- End CTA -->
    </div>
    <!-- End Footer -->
  </div>
  <!-- End Body -->
</article>
