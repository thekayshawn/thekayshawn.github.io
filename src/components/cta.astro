---
import { footerStrings, strings } from "@utils/strings";
import GetInTouch from "./GetInTouch.astro";
import Icon from "astro-icon";
import Contactform from "./contactform.astro";

const linkProps = {
  target: "_blank",
  rel: "noreferrer",
  class: "link before-ornament",
};

const { title, description, cta } = footerStrings;

const getLinkProps = (className?: string) => ({
  target: "_blank",
  rel: "noreferrer",
  class: `${className} hover:text-pink-400 focus:text-pink-400 before-ornament`,
});

const basicLinkProps = getLinkProps("text-black");

const menuLinkClassName =
  "flex items-center mt-2 space-x-2 text-slate-400 w-fit [&_svg]:text-slate-200";

const menuLinkProps = getLinkProps(menuLinkClassName);
---

<div
  id="contact"
  class="bg-black p-8 md:px-20 md:py-20 mt-20 mx-auto rounded-lg flex flex-col items-center text-center">
  {
    !title.isHidden && (
      <h2
        class="text-white text-4xl md:text-6xl tracking-tight"
        set:html={title.value}
      />
    )
  }
  <div
    class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16 text-slate-400">
    <div>
      <p class="leading-relaxed text-left">
        Send me an email or message me on LinkedIn if you're looking for someone
        who builds without BS.
      </p>
      <div class="mt-5">
        <a {...menuLinkProps} href={`mailto:${strings.emailAddress}`}>
          <Icon class="w-4 h-4" name={strings.emailAddressIcon} />
          <span>
            {strings.emailAddress}
          </span>
          <!-- <Icon
            class="w-4 h-4 -translate-x-1 text-pink-600"
            name="bx:bx-link"
          /> -->
        </a>
        <a {...menuLinkProps} href={`tel:${strings.phoneNumber}`}>
          <Icon class="w-4 h-4" name={strings.phoneNumberIcon} />
          <span> {strings.phoneNumberDisplay}</span>
          <!-- <Icon
            class="w-4 h-4 -translate-x-1 text-pink-600"
            name="bx:bx-link"
          /> -->
        </a>
        <div class={menuLinkClassName}>
          <Icon class="w-4 h-4" name={strings.addressIcon} />
          <span>{strings.address}</span>
        </div>
      </div>
    </div>
    <div>
      <Contactform />
    </div>
  </div>
</div>
<style>
  .link {
    @apply text-slate-300 hover:text-pink-300 focus:text-pink-300;
  }
</style>
