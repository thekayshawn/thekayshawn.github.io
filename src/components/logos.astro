---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24">
  <div class="flex gap-8 items-center justify-center mt-10 flex-wrap">
    <span
      title="React"
      class="hover:text-pink-600 focus:text-pink-600 transition-colors">
      <Icon class="h-8" name="simple-icons:react" />
    </span>
    <span
      title="Next.js"
      class="hover:text-pink-600 focus:text-pink-600 transition-colors">
      <Icon class="h-8" name="simple-icons:nextdotjs" />
    </span>
    <span
      title="Node.js"
      class="hover:text-pink-600 focus:text-pink-600 transition-colors">
      <Icon class="h-8" name="simple-icons:nodedotjs" />
    </span>
    <span
      title="Tailwind CSS"
      class="hover:text-pink-600 focus:text-pink-600 transition-colors">
      <Icon class="h-8" name="simple-icons:tailwindcss" />
    </span>
    <span
      title="Cloudflare"
      class="hover:text-pink-600 focus:text-pink-600 transition-colors">
      <Icon class="h-8" name="simple-icons:cloudflare" />
    </span>
  </div>
</div>
