---
import { heroStrings } from "@utils/strings";
import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";
import heroImage from "../../public/avatar.png";
import Link from "./ui/link.astro";

const { image, title, summary } = heroStrings;
---

<main class="grid lg:grid-cols-2 place-items-center pt-16 md:pt-12">
  {
    !image.isHidden && (
      <div class="py-6 md:order-1 hidden md:block text-right">
        <Picture
          format="webp"
          quality="max"
          loading="eager"
          src={heroImage}
          class="max-w-xs -scale-x-100 rounded-lg"
          widths={[200, 400, 600]}
          alt="Kashan's avatar"
          sizes="(max-width: 800px) 100vw, 620px"
        />
      </div>
    )
  }
  <div>
    <!-- <a
      href="#contact"
      class="mb-4 sm:mb-6 flex items-center gap-1 underline decoration-green-600 underline-offset-4">
      <Icon class="size-5 text-green-600" name="bx:bx-bolt-circle" />
      Looking for work
    </a> -->
    {
      !title.isHidden && (
        <h1
          class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter"
          set:html={title.value}
        />
      )
    }
    {
      !summary.isHidden && (
        <p class="text-lg mt-4 text-slate-600 max-w-xl">{summary.value}</p>
      )
    }
    <div class="flex items-center gap-2 mt-5">
      <Link href="#projects" class="grow sm:grow-0" style="pink">
        See my work
        <Icon name="bx:bx-down-arrow-alt" />
      </Link>
      <Link href="/about" class="grow sm:grow-0" style="outline">
        More about me
      </Link>
    </div>
  </div>
</main>
